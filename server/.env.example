PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skillchain
AUTH_TOKEN_SECRET=change_this_to_a_long_random_string

# Gemini AI — get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI settings
AI_TIMEOUT_MS=8000
MAX_RESUME_CHARACTERS=200000
CLIENT_ORIGINS=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173

# SMTP password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional local EVM credential chain; approvals require all three values
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key
BLOCKCHAIN_CONTRACT_ADDRESS=your_deployed_contract_address

# Cloudinary (Media & Document Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
